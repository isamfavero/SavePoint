# Copie este arquivo para ".env" (na mesma pasta) e preencha com os dados do
# seu projeto no Supabase: Project Settings > API (ou "Connect" no painel).
# O arquivo .env NÃO vai para o Git. Nunca cole essas chaves no chat ou no código.

# URL do projeto, algo como https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Chave PÚBLICA: a "publishable key" (sb_publishable_...) ou a antiga "anon key".
# Nunca use aqui a "secret key" nem a "service_role".
VITE_SUPABASE_ANON_KEY=
